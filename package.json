{
	"name": "torrin.me",
	"version": "1.0.0",
	"description": "My personal portfolio website.",
	"type": "module",
	"workspaces": [
		"aweft/packages/*",
		"radio"
	],
	"scripts": {
		"content": "node --import @aweftjs/build/loader content/blog.ts",
		"dev": "npm run content && vite --configLoader native",
		"build": "bash build.sh",
		"pages": "AWEFT_DEFAULT_H=@aweftjs/ui node --import @aweftjs/build/loader frontend/pages.ts",
		"start": "node --env-file-if-exists=.env --import @aweftjs/build/loader main.ts",
		"resume:pdf": "node --import @aweftjs/build/loader resume.ts",
		"radio": "node radio/main.ts",
		"soundfont": "node radio/soundfont.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts",
		"proof": "node --import @aweftjs/build/loader proof.ts",
		"gate": "npm run content && npm run typecheck && npm run build && npm test && npm run proof"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/torrinleonard.com.git"
	},
	"author": "Torrin Leonard",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/torrinworx/torrinleonard.com/issues"
	},
	"homepage": "https://github.com/torrinworx/torrinleonard.com#readme",
	"dependencies": {
		"@aweftjs/build": "*",
		"@aweftjs/client": "*",
		"@aweftjs/codec": "*",
		"@aweftjs/core": "*",
		"@aweftjs/dom": "*",
		"@aweftjs/health": "*",
		"@aweftjs/icons": "*",
		"@aweftjs/logs": "*",
		"@aweftjs/modules": "*",
		"@aweftjs/server": "*",
		"@aweftjs/ssg": "*",
		"@aweftjs/static": "*",
		"@aweftjs/store": "*",
		"@aweftjs/ui": "*",
		"pg": "^8.15.6"
	},
	"devDependencies": {
		"@iconify-json/feather": "^1.2.1",
		"@iconify-json/simple-icons": "^1.2.1",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"nodemon": "^3.1.7",
		"pdfkit": "^0.20.2",
		"playwright": "1.62.1",
		"shiki": "^4.4.3",
		"typescript": "^5.7.0",
		"vite": "^8.2.2",
		"yaml": "^2.9.1"
	}
}
